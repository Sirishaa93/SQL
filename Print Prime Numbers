SET @num = 1;

SELECT GROUP_CONCAT(n SEPARATOR '&')
FROM
(
    SELECT @num := @num + 1 AS n
    FROM information_schema.tables t1, information_schema.tables t2
    LIMIT 1000
) numbers
WHERE NOT EXISTS
(
    SELECT 1
    FROM
    (
        SELECT @i := @i + 1 AS d
        FROM information_schema.tables, (SELECT @i := 1) init
        LIMIT 1000
    ) divisors
    WHERE d < n
    AND d > 1
    AND MOD(n,d) = 0
);
